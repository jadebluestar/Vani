# Copy to .env and fill in real values. Every field below is required by
# app/config.py (no defaults) except where noted — the app will fail to start
# without them. Supabase/Redis are optional at runtime (the app falls back to
# local SQLite / an in-memory cache if unreachable) but Settings() still needs
# *some* value for every field.

# Supabase (falls back to local SQLite if unreachable)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Groq / OpenRouter (falls back to mock responses if the key is missing/invalid)
GROQ_API_KEY=gsk_your_groq_key_or_sk-or-v1-your_openrouter_key

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Redis (falls back to an in-memory cache if unreachable)
REDIS_URL=redis://localhost:6379

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+10000000000

# Cloudflare R2
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=vani-audio
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Solana (mock mode is used automatically if solana libraries aren't installed)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET_PRIVATE_KEY=your-base58-private-key

# App
APP_ENV=development
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Rate limiting (requests per RATE_LIMIT_WINDOW seconds)
RATE_LIMIT_FREE=10
RATE_LIMIT_PREMIUM=50
RATE_LIMIT_WINDOW=60

# Audio cleanup
AUDIO_RETENTION_DAYS=7
